; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ortobio"
config/description="Simulatore agronomico 2D pixel art verticale per Android"
run/main_scene="res://scenes/FieldScreen.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=360
window/size/viewport_height=760
window/size/window_width_override=405
window/size/window_height_override=855
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.24, 0.38, 0.22, 1)
